#!/usr/bin/env bash
# Resolve and ensure the working-tree directory PDD uses for one plan's
# short-lived artifacts: task briefs, pane reports, review packages, and the
# progress ledger. Print the plan directory's absolute path.
#
# One directory per plan (.herdrpowers/pdd/<plan-basename>/) so a follow-up
# plan in the same working tree can never read or overwrite another plan's
# artifacts. A stale ledger misread as current progress makes orchestrators
# skip whole task sequences — plan-scoping removes that failure structurally.
#
# The workspace lives in the working tree (not under .git/) because some agent
# harnesses treat .git/ as a protected path and deny writes there — which blocks
# a delegated pane from writing its report file. A self-ignoring
# .gitignore at .herdrpowers/pdd/ keeps every plan's workspace out of
# `git status` and out of accidental commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# Usage: pdd-workspace [PLAN_FILE]
# With no PLAN_FILE (plan-less flows such as /quick), the slug is `adhoc`.
set -euo pipefail

if [ $# -gt 1 ]; then
  echo "usage: pdd-workspace [PLAN_FILE]" >&2
  exit 2
fi

if [ $# -eq 1 ] && [ "$1" != "-" ]; then
  plan=$1
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
  slug=$(basename "$plan" .md)
  [ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
    || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }
else
  slug=adhoc
fi

root=$(git rev-parse --show-toplevel)
base="$root/.herdrpowers/pdd"
dir="$base/$slug"
mkdir -p "$dir"
printf '*\n' > "$base/.gitignore"
cd "$dir" && pwd
